// Minty on Cloudflare Workers — one deployment per household (docs/serverless-plan.md, SETUP.md).
//
// This file is shared by every household's fork, so it holds NO per-household values. That's
// what keeps "Sync fork" conflict-free:
//   * the D1 database is created on the first deploy and found by name afterwards (no id here);
//   * household settings are Worker variables set in the Cloudflare dashboard (or as secrets),
//     which keep_vars preserves across deploys. Anything unset falls back to the default shown:
//       ACCESS_TEAM_DOMAIN  (required) "<team>.cloudflareaccess.com"; unset = every API call refused
//       ACCESS_AUD          (required) the Access application's AUD tag
//       MINTY_USERS         "me:Me"                people, in display order ("key:Label,..."); 2+ adds the person switch
//       PLAID_SLOTS         "primary,backup"       Plaid accounts per person, in overflow order;
//                                                  each slot = one more Plaid Trial (10 logins)
//       PLAID_ENV           "sandbox"              "production" once you use real banks
//       ALLOWED_LOGINS      ""                     optional extra allow-list of Access emails
//       PLAID_REDIRECT_URI  ""                     only for OAuth banks in mobile webviews (HTTPS)
//       TRIAL_ITEM_CAP      "10"                   Plaid Trial logins per credential set
//       SYNC_MAX_PAGES_PER_RUN "10"                Plaid pages (100 transactions each) per cron run
//       SYNC_MAX_BYTES_PER_RUN "150000"            page text per run (median ~8 ms CPU; free plan allows 10)
//                                                  on Workers Paid: 20000000 bytes / 50 pages
//       READ_BUDGET_PER_DAY "3000000"              D1 rows the pages may read per UTC day before
//                                                  browsing and search pause (sync never does);
//                                                  the free plan allows 5,000,000. "0" = no limit
//   * rate limits (the "ratelimits" bindings below) are the same for everyone: 120 API requests a
//     minute per login, 30 searches / ABC loads, 10 bank-linking calls. Their namespace ids are
//     fixed numbers, unusual so they don't share counters with another Worker on your account.
//   * secrets (Plaid keys, TOKEN_ENC_KEY) likewise live only in the dashboard / `wrangler secret put`,
//     or in .dev.vars locally. See .dev.vars.example.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minty",                          // must match the Worker's name in the dashboard
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",

  // Keep variables set in the dashboard when deploying (there are none in this file to clash).
  "keep_vars": true,

  // No per-version Preview URLs (<version>-minty.<subdomain>.workers.dev). They would serve
  // untested branch code with the household's production secrets and database. Every deploy
  // enforces this; left unset, Wrangler would keep whatever the dashboard says.
  "preview_urls": false,

  // The dashboard pages, served as-is. API paths run the Worker first; everything else is a
  // static file. Cloudflare Access protects both at the edge.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/status",
      "/users",
      "/items",
      "/health",
      "/accounts",
      "/capacity",
      "/transactions",
      "/transactions/*",
      "/tags",
      "/sync-request",
      "/benefits",
      "/benefits/*",
      "/liabilities",
      "/liabilities/*",
      "/manual-bills",
      "/manual-bills/*",
      "/link/*"
    ]
  },

  // Per login (the Access email), per minute; counted per Cloudflare location (src/limits.ts).
  "ratelimits": [
    { "name": "RL_GENERAL", "namespace_id": "714101", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SEARCH",  "namespace_id": "714102", "simple": { "limit": 30,  "period": 60 } },
    { "name": "RL_LINK",    "namespace_id": "714103", "simple": { "limit": 10,  "period": 60 } }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minty",               // created by the first deploy, then reused by name
      "migrations_dir": "d1/migrations"
    }
  ],

  // Sync (UTC), the only way it runs: no HTTP endpoint. Hourly for every bank, off the top of
  // the hour; plus every 10 minutes for banks partway through a download (src/sync.ts
  // CATCH_UP_CRON, which must match), which does nothing once every bank is caught up.
  // The third trigger leases one opted-in bank for daily statement updates (LIABILITIES_CRON).
  "triggers": { "crons": ["17 * * * *", "*/10 * * * *", "3,13,23,33,43,53 * * * *"] },

  "observability": { "enabled": true }
}
