# Worker secrets. Locally: copy to .dev.vars (gitignored, never deployed); `npm run dev` reads it.
# Deployed: set each with `npx wrangler secret put <NAME>` (the Deploy button also prompts for these).
# Nothing here may weaken auth: the local-only Access bypass is passed by `npm run dev` instead.

# Plaid SANDBOX keys (dashboard.plaid.com -> Developers -> Keys). Not needed to browse seed data.
PLAID_CLIENT_ID_ME_PRIMARY=
PLAID_SECRET_ME_PRIMARY=
PLAID_CLIENT_ID_ME_BACKUP=
PLAID_SECRET_ME_BACKUP=
# More people: list them in MINTY_USERS (e.g. me:Alex,sam:Sam) and add their keys the same way,
# e.g. PLAID_CLIENT_ID_SAM_PRIMARY / PLAID_SECRET_SAM_PRIMARY. The Add user page lists the names.

# Fernet key for Plaid access tokens (used from P2). Generate once:
#   openssl rand -base64 32 | tr '+/' '-_'
TOKEN_ENC_KEY=
# Only while changing the key (SETUP.md, "Changing the encryption key"): TOKEN_ENC_KEY_PREVIOUS,
# the old key. Not listed as a line here, so the Deploy button doesn't ask for it.
